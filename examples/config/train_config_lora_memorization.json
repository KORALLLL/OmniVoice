{
    "llm_name_or_path": "Qwen/Qwen3-0.6B",
    "audio_vocab_size": 1025,
    "audio_mask_id": 1024,
    "num_audio_codebook": 8,

    "audio_codebook_weights": [8, 8, 6, 6, 4, 4, 2, 2],
    "drop_cond_ratio": 0.0,
    "prompt_ratio_range": [0.3, 0.3],
    "mask_ratio_range": [1.0, 1.0],
    "language_ratio": 1.0,
    "use_pinyin_ratio": 0.0,
    "instruct_ratio": 0.0,
    "only_instruct_ratio": 0.0,

    "resume_from_checkpoint": null,
    "init_from_checkpoint": "k2-fsa/OmniVoice",

    "lora_enabled": true,
    "lora_rank": 64,
    "lora_alpha": 128,
    "lora_dropout": 0.0,
    "lora_bias": "none",
    "lora_target_modules": [
        "q_proj", "k_proj", "v_proj", "o_proj",
        "gate_proj", "up_proj", "down_proj",
        "embed_tokens", "audio_embeddings", "audio_heads"
    ],

    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "steps": 10000,
    "stop_after_step": 10000,
    "max_wall_clock_seconds": 1200,
    "early_stop_eval_loss": 0.0001,
    "early_stop_patience": 2,
    "seed": 42,
    "warmup_type": "ratio",
    "warmup_ratio": 0.01,
    "warmup_steps": 0,

    "batch_tokens": 4096,
    "gradient_accumulation_steps": 1,
    "num_workers": 2,
    "max_batch_size": 4,

    "mixed_precision": "bf16",
    "allow_tf32": true,
    "attn_implementation": "sdpa",

    "logging_steps": 25,
    "eval_steps": 25,
    "save_steps": 25,
    "keep_last_n_checkpoints": -1
}
